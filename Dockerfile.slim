# Stage 1: Builder
FROM node:24-slim AS builder

RUN apt-get update && apt-get install -y python3 python3-pip sqlite3 git curl && rm -rf /var/lib/apt/lists/*

WORKDIR /home/vane

# Copy only package files first for better layer caching
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000 && \
    rm -rf /root/.cache /tmp/* ~/.yarn/cache

# Copy application source
COPY tsconfig.json next.config.mjs next-env.d.ts postcss.config.js drizzle.config.ts tailwind.config.ts ./
COPY src ./src
COPY public ./public
COPY drizzle ./drizzle

RUN mkdir -p /home/vane/data
RUN yarn build && \
    rm -rf /root/.cache /tmp/* ~/.yarn/cache /home/vane/node_modules/.cache

# Stage 2: Runtime
FROM node:24-slim AS runtime

# Install only Chromium headless shell system dependencies (no Firefox/WebKit needed)
RUN apt-get update && apt-get install -y \
    chromium-headless-shell \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libxcomposite1 libxdamage1 \
    libxrandr2 libgbm1 libpango-1.0-0 \
    libdrm2 libxshmfence1 libx11-xcb1 \
    fonts-liberation libasound2 \
    python3 python3-pip sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /home/vane

# Copy standalone build from builder (includes node_modules from builder's yarn install)
COPY --from=builder /home/vane/public ./public
COPY --from=builder /home/vane/.next/static ./public/_next/static
COPY --from=builder /home/vane/.next/standalone ./
COPY --from=builder /home/vane/drizzle ./drizzle
COPY --from=builder /home/vane/data ./data

# Create uploads directory
RUN mkdir -p /home/vane/uploads && chown -R node:node /home/vane

# Use non-root node user for security
USER node

EXPOSE 3000

ENV NODE_ENV=production

CMD ["node", "server.js"]
